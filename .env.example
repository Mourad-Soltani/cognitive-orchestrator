# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Orchestrator Settings
ORCHESTRATOR_TIMEOUT_MS=150
MAX_CONCURRENT_AGENTS=5

# Articulation Cortex
ARTICULATION_TEMP_START=1.2
ARTICULATION_TEMP_END=0.3
ARTICULATION_MAX_TOKENS=512

# Dialectic Council
DIALECTIC_MAX_TOKENS=256
DIALECTIC_STOP_SEQUENCE=|

# Recency Buffer
BUFFER_MAXLEN=3
COMPRESSION_MAX_WORDS=50

# Insight Spike
INSIGHT_NOISE_STD=0.1
INSIGHT_THRESHOLD=0.3

# Pruning Weights
PRUNER_ALPHA=0.5
PRUNER_BETA=0.3
PRUNER_GAMMA=0.2
PRUNER_TOP_K=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
